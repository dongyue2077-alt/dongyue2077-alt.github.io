---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fmtDate } from '../../utils/date';
import { href } from '../../utils/url';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await render(post);

// 上下篇：按时间倒序排好后取相邻两条
const all = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const index = all.findIndex((p) => p.id === post.id);
const newer = index > 0 ? all[index - 1] : undefined;
const older = index < all.length - 1 ? all[index + 1] : undefined;

const { title, description, date, updated, tags, series } = post.data;
const wasUpdated = updated && updated.valueOf() > date.valueOf();
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="article-header">
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={date.toISOString()}>{fmtDate(date)}</time>
        {wasUpdated && <span>更新于 {fmtDate(updated)}</span>}
        {series && <span class="series-badge">系列 · {series}</span>}
      </div>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>
                <a class="tag" href={href(`/tags/${encodeURIComponent(tag)}/`)}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  {
    (newer || older) && (
      <nav class="pager">
        <div>
          {newer && (
            <>
              <span class="label">更新的一篇</span>
              <a href={href(`/posts/${newer.id}/`)}>{newer.data.title}</a>
            </>
          )}
        </div>
        <div class="next">
          {older && (
            <>
              <span class="label">更早的一篇</span>
              <a href={href(`/posts/${older.id}/`)}>{older.data.title}</a>
            </>
          )}
        </div>
      </nav>
    )
  }
</BaseLayout>

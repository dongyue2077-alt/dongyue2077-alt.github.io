---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../utils/url';
---

<BaseLayout title="页面不存在" description="没有找到这个页面。">
  <div class="notfound">
    <h1>404</h1>
    <p>这个地址没有内容，可能是链接过期了。</p>
    <p style="margin-top:2rem;"><a class="more" href={href('/')}>回到首页 →</a></p>
  </div>
</BaseLayout>

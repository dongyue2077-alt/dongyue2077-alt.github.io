---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fmtDate, groupByYear } from '../utils/date';
import { href } from '../utils/url';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const years = groupByYear(posts);
---

<BaseLayout title="归档" description="全部文章，按年份排列。">
  <h1 class="page-title">
    归档
  </h1>

  {
    years.length === 0 && <p class="empty">还没有文章。</p>
  }

  {
    years.map(([year, items]) => (
      <section class="year-group">
        <h2>{year}</h2>
        <ul class="archive-list">
          {items.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
              <a href={href(`/posts/${post.id}/`)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
